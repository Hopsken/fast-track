{
  "name": "jira-boost",
  "displayName": "Jira Boost",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Quick search and access to your Jira tickets with enhanced board experience. Search by ticket key, summary, assignee, or status with lightning-fast results.",
  "author": "hopsken",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run extension:dev",
    "dev:ff": "nx run extension:dev:ff",
    "dev:edge": "nx run extension:dev:edge",
    "build": "nx run extension:build",
    "build:chrome": "nx run extension:build-chrome",
    "build:ff": "nx run extension:build-firefox",
    "build:edge": "nx run extension:build-edge",
    "zip": "nx run extension:zip",
    "zip:chrome": "nx run extension:zip-chrome",
    "zip:firefox": "nx run extension:zip-firefox",
    "clean": "rimraf build",
    "postinstall": "pnpm -C apps/extension exec wxt prepare",
    "lint": "nx run extension:lint",
    "lint:fix": "nx run extension:lint:fix",
    "format": "nx run extension:format",
    "format:check": "nx run extension:format:check",
    "typecheck": "nx run extension:typecheck"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.1.0",
    "@radix-ui/react-label": "^2.1.7",
