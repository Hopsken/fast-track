    "ky": "^1.10.0",
    "lodash-es": "^4.17.21",
    "loglevel": "^1.9.2",
    "nanoid": "^5.1.5",
    "next": "~15.2.4",
    "p-queue": "^8.1.1",
    "react": "19.1.1",
