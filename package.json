{
  "name": "fast-track",
  "displayName": "Fast Track",
  "version": "2.4.3",
  "private": true,
  "type": "module",
  "description": "Quick search and access to your Jira tickets with enhanced board experience. Search by ticket key, summary, assignee, or status with lightning-fast results.",
  "author": "hopsken",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter=extension",
    "dev:extension": "turbo run dev --filter=extension",
    "dev:website": "turbo run dev --filter=website",
    "build:website": "turbo run build --filter=website",
    "zip": "turbo run zip --filter=extension",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter extension test:e2e",
    "test:coverage": "turbo run test -- --coverage",
    "prepare": "husky",
    "clean": "rimraf build",
    "postinstall": "pnpm -C apps/extension exec wxt prepare",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rimraf": "^6.0.1",
    "syncpack": "^13.0.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
