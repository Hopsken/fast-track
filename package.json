{
  "name": "jira-boost",
  "displayName": "Jira Boost",
  "version": "2.0.0",
  "type": "module",
  "description": "Quick search and access to your Jira tickets with enhanced board experience. Search by ticket key, summary, assignee, or status with lightning-fast results.",
  "author": "hopsken",
  "scripts": {
    "dev": "wxt -b chromium",
    "dev:ff": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "tsc --noEmit && eslint src --ext .ts,.tsx && wxt build -b chromium",
    "build:ff": "tsc --noEmit && eslint src --ext .ts,.tsx && wxt build -b firefox",
    "build:edge": "tsc --noEmit && eslint src --ext .ts,.tsx && wxt build -b edge",
    "zip": "pnpm run zip:chrome && pnpm rnn zip:firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "clean": "rimraf build",
    "postinstall": "wxt prepare",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@webext-core/proxy-service": "^1.2.1",
    "ahooks": "^3.9.3",
    "cash-dom": "^8.1.5",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.1.0",
    "nanoid": "^5.1.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-hotkeys-hook": "^5.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.1",
    "screenfull": "^6.0.2",
    "swr": "^2.3.6",
    "unimport": "^5.2.0",
    "unsplash-js": "^7.0.19",
    "wxt": "^0.20.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/chrome": "0.1.4",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@wxt-dev/auto-icons": "^1.1.0",
    "@wxt-dev/module-react": "^1.1.3",
    "daisyui": "^5.0.50",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^60.0.0",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.12",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}