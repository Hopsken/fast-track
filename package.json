{
  "name": "jira-boost",
  "displayName": "Jira Boost",
  "version": "0.0.3",
  "description": "All in one Jira experience boost with power-ups including standup mode, custom theme and etc.",
  "author": "hopsken",
  "scripts": {
    "dev": "plasmo dev",
    "dev:ff": "plasmo dev --target=firefox-mv2",
    "build": "plasmo build",
    "build:ff": "plasmo build --target=firefox-mv2",
    "package": "plasmo package"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^3.6.0",
    "@plasmohq/storage": "^1.6.1",
    "@tailwindcss/typography": "^0.5.9",
    "ahooks": "^3.7.8",
    "cash-dom": "^8.1.5",
    "date-fns": "^2.30.0",
    "nanoid": "^4.0.2",
    "plasmo": "0.77.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.10.1",
    "react-router-dom": "^6.14.0",
    "screenfull": "^6.0.2",
    "swr": "^2.2.0",
    "unsplash-js": "^7.0.18",
    "webextension-polyfill": "^0.10.0"
  },
  "devDependencies": {
    "@plasmohq/prettier-plugin-sort-imports": "3.6.4",
    "@types/chrome": "0.0.237",
    "@types/node": "20.2.4",
    "@types/react": "18.2.7",
    "@types/react-dom": "18.2.4",
    "@types/webextension-polyfill": "^0.10.1",
    "autoprefixer": "^10.4.14",
    "daisyui": "^3.1.6",
    "postcss": "^8.4.24",
    "prettier": "2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.3.2",
    "typescript": "5.0.4"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "omnibox"
    ],
    "omnibox": {
      "keyword": "jira"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "{df6c8f8c-469a-4c88-8b45-23ff390f1d7d}"
      }
    }
  }
}
