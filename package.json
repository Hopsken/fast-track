    "ahooks": "^3.9.3",
    "cash-dom": "^8.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.1.0",
    "jira.js": "^5.2.2",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.1.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-hotkeys-hook": "^5.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.1",
    "rxjs": "^7.8.2",
    "screenfull": "^6.0.2",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "unimport": "^5.2.0",
