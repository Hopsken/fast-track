{
  "name": "fast-track",
  "displayName": "Fast Track",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Quick search and access to your Jira tickets with enhanced board experience. Search by ticket key, summary, assignee, or status with lightning-fast results.",
  "author": "hopsken",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=extension",
    "build": "turbo run build --filter=extension",
    "dev:website": "turbo run dev --filter=website",
    "build:website": "turbo run build --filter=website",
    "zip": "turbo run zip --filter=extension",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "prepare": "husky",
    "clean": "rimraf build",
    "postinstall": "pnpm -C apps/extension exec wxt prepare",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.1.0",
    "@internal/logger": "workspace:*",
    "@internal/ui": "workspace:*",
    "@radix-ui/react-label": "^2.1.7",
    "@tailwindcss/typography": "^0.5.16",
    "@webext-core/messaging": "^2.3.0",
    "@webext-core/proxy-service": "^1.2.1",
    "ahooks": "^3.9.3",
    "cash-dom": "^8.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.1.0",
    "jira.js": "^5.2.2",
    "ky": "^1.10.0",
    "lodash-es": "^4.17.21",
    "loglevel": "^1.9.2",
    "lucide-react": "^0.555.0",
    "nanoid": "^5.1.5",
    "next": "~15.2.4",
    "p-queue": "^8.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-hotkeys-hook": "^5.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.1",
    "rxdb": "^16.19.0",
    "rxjs": "^7.8.2",
    "screenfull": "^6.0.2",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "unimport": "^5.2.0",
    "unsplash-js": "^7.0.19",
    "wxt": "^0.20.8",
    "zod": "^4.1.9",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/chrome": "0.1.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitest/coverage-v8": "3.2.4",
    "@wxt-dev/auto-icons": "^1.1.0",
    "@wxt-dev/module-react": "^1.1.3",
    "daisyui": "^5.0.50",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rimraf": "^6.0.1",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "turbo": "^2.6.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
