{
  "$schema": "https://v2-8-3.turborepo.dev/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "dev": { "cache": false, "persistent": true },

    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", ".next/**", "!.next/cache/**", "dist/**"]
    },

    "website#build": {
      "env": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_WEBSITE_URL",
        "SUPABASE_SECRET_KEY",
        "LEMONSQUEEZY_PRO_CHECKOUT_URL",
        "LEMONSQUEEZY_WEBHOOK_SECRET",
        "JIRA_CLIENT_ID",
        "JIRA_CLIENT_SECRET"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },

    "extension#build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json", ".env*"],
      "outputs": [".output/**"],
      "env": ["WXT_UMAMI_WEBSITE_ID", "DEV", "VITE_E2E_MOCKS"]
    },

    "zip": {
      "dependsOn": ["build"],
      "outputs": [".output/**"]
    },

    "lint": { "dependsOn": ["^lint"] },
    "lint:fix": { "cache": false, "dependsOn": ["^lint:fix"] },
    "typecheck": {
      "dependsOn": ["^transit"]
    },

    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"],
      "dependsOn": ["transit"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    }
  }
}
