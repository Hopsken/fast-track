{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "extension",
  "projectType": "application",
  "root": "apps/extension",
  "sourceRoot": "apps/extension/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/extension",
        "command": "wxt -b chromium"
      }
    },
    "dev:ff": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/extension",
        "command": "wxt -b firefox"
      }
    },
    "dev:edge": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/extension",
        "command": "wxt -b edge"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/extension",
        "command": "wxt build -b chromium"
      },
      "outputs": ["{projectRoot}/.output"]
    },
    "build-chrome": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/extension",
        "command": "wxt build -b chrome"
      },
      "outputs": ["{projectRoot}/.output"]
    },
    "build-firefox": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/extension",
        "command": "wxt build -b firefox"
      },
      "outputs": ["{projectRoot}/.output"]
    },
    "build-edge": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/extension",
        "command": "wxt build -b edge"
      },
      "outputs": ["{projectRoot}/.output"]
    },
    "zip": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/extension",
        "command": "wxt zip -b chrome && wxt zip -b firefox"
      },
      "outputs": ["{projectRoot}/.output"]
    },
    "zip-chrome": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/extension",
        "command": "wxt zip -b chrome"
      },
      "outputs": ["{projectRoot}/.output"]
    },
    "zip-firefox": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/extension",
        "command": "wxt zip -b firefox"
      },
      "outputs": ["{projectRoot}/.output"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/extension/src/**/*.{ts,tsx,js,jsx}"],
        "format": "stylish"
      }
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/extension/src/**/*.{ts,tsx,js,jsx}"],
        "fix": true,
        "format": "stylish"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/extension",
        "command": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\""
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/extension",
        "command": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\""
      }
    }
  },
  "tags": []
}
