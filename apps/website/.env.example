# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
# Use the Supabase "publishable" key (new naming)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-only)
# New naming: "secret key" (admin). Used for billing/webhook sync.
SUPABASE_SECRET_KEY=

# Public website base URL (used for OAuth redirects)
# Dev: http://localhost:4000
NEXT_PUBLIC_WEBSITE_URL=

# LemonSqueezy (subscriptions)
# Hosted checkout URL
# Note: LemonSqueezy test/live modes use different checkout URLs.
# Configure the right URL per environment (dev/preview/prod).
LEMONSQUEEZY_PRO_CHECKOUT_URL=

# Used to verify webhook signatures
LEMONSQUEEZY_WEBHOOK_SECRET=
# Used to retrieve signed Customer Portal URLs
LEMONSQUEEZY_API_KEY=

# Jira OAuth (existing)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Extension Auth (server-only)
# Used to sign extension access/refresh tokens
EXTENSION_JWT_SECRET=
