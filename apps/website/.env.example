# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
# Use the Supabase "publishable" key (new naming)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-only)
# New naming: "secret key" (admin). Used for billing/webhook sync.
SUPABASE_SECRET_KEY=

# Public website base URL (used for OAuth redirects)
# Dev: http://localhost:4000
NEXT_PUBLIC_WEBSITE_URL=

# LemonSqueezy (subscriptions)
# Mode selection (optional)
# - production defaults to live
# - preview/development defaults to test
LEMONSQUEEZY_MODE=

# Hosted checkout URLs
# Test checkout URL is REQUIRED when in test mode.
LEMONSQUEEZY_PRO_CHECKOUT_URL_TEST=
# Optional override; otherwise uses the committed live URL.
LEMONSQUEEZY_PRO_CHECKOUT_URL_LIVE=

# Used to verify webhook signatures
LEMONSQUEEZY_WEBHOOK_SECRET=
# Used to retrieve signed Customer Portal URLs
LEMONSQUEEZY_API_KEY=

# Jira OAuth (existing)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Extension Auth (server-only)
# Used to sign extension access/refresh tokens
EXTENSION_JWT_SECRET=
