{
  "extends": "../../tsconfig.base.json",
  "files": [],
  "include": [
    "*.d.ts",
    "*.ts",
    ".next/types/**/*.ts",
    "specs/**/*",
    "src/**/*",
    "../../dist/apps/website/.next/types/**/*.ts"
  ],
  "references": [
    {
      "path": "../../packages/logger"
    }
  ],
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "exclude": ["node_modules"]
}
