{
  "extends": "../../tsconfig.base.json",
  "files": [],
  "include": [
    "*.d.ts",
    "*.ts",
    "specs/**/*",
    "src/**/*",
    ".next/types/**/*.ts"
  ],
  "references": [
    {
      "path": "../../packages/logger"
    }
  ],
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "exclude": [
    "node_modules"
  ]
}
